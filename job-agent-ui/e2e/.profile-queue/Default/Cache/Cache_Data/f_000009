/* My Job Agent — client. Talks to server.js API; all data is real pipeline output. */
"use strict";

let DATA = null; // { profile, boards, jobs, decisions, log }

/* ---------- helpers ---------- */
const $ = (s, el = document) => el.querySelector(s);
const $$ = (s, el = document) => [...el.querySelectorAll(s)];
const esc = (s) => String(s ?? "").replace(/[&<>\"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

function grade(m) {
  if (m >= 75) return ["g-hi", "bg-hi"];
  if (m >= 50) return ["g-mid", "bg-mid"];
  return ["g-lo", "bg-lo"];
}

async function api(path, opts) {
  const r = await fetch(path, opts);
  if (!r.ok) throw new Error(`${path} -> ${r.status}`);
  return r.json();
}

function post(path, body) {
  return api(path, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body || {}),
  });
}

/* ---------- step navigation ---------- */
const ORDER = ["profile", "boards", "match", "approve", "apply"];

function goto(step) {
  $$(".step").forEach((b) => {
    const s = b.dataset.step;
    b.classList.toggle("active", s === step);
    b.classList.toggle("done", ORDER.indexOf(s) < ORDER.indexOf(step));
  });
  $$(".panel").forEach((p) => p.classList.toggle("active", p.id === `panel-${step}`));
  $(".main").scrollTop = 0;
  if (step === "approve") renderQueue();
  if (step === "apply") renderTimeline();
}

document.addEventListener("click", (e) => {
  const stepBtn = e.target.closest(".step");
  if (stepBtn) return goto(stepBtn.dataset.step);
  const gotoBtn = e.target.closest("[data-goto]");
  if (gotoBtn) return goto(gotoBtn.dataset.goto);
});

/* ---------- step 1: profile ---------- */
function renderProfile() {
  const p = DATA.profile;
  $("#f-name").value = p.name;
  $("#f-email").value = p.email;
  $("#f-phone").value = p.phone;
  $("#f-location").value = p.location;
  $("#role-chips").innerHTML = p.targetRoles.map((r) => `<span class="chip">${esc(r)}</span>`).join("");

  // Fill pack: count ready values, list the questions the agent must ask.
  const f = DATA.fill;
  if (f) {
    const flat = [];
    (function walk(o, depth) {
      if (depth > 4 || o == null) return;
      if (Array.isArray(o)) return o.forEach((v) => walk(v, depth + 1));
      if (typeof o !== "object") return;
      for (const [k, v] of Object.entries(o)) {
        if (k.startsWith("_") || k === "askUser" || k === "questions") continue;
        if (v === null) continue;
        if (typeof v === "object") walk(v, depth + 1);
        else flat.push(k);
      }
    })(f, 0);
    const need = (f.askUser || []).length;
    $("#fill-ready").textContent = `${flat.length} fields ready`;
    $("#fill-need").textContent = `${need} open`;
    $("#fill-ask").innerHTML = (f.askUser || [])
      .map((a) => `<li><b>${esc(a.field)}</b> — ${esc(a.why)}</li>`)
      .join("");
  }
}

/* ---------- step 2: jobs ----------
 * This step is the JOB LIST, not a board list: the boards themselves are an
 * implementation detail the user never has to manage. Every matched job from
 * every board is one card (title, description, location, experience, board)
 * with a single Apply button, and the connection to that board is established
 * behind the scenes when Apply is pressed — the extension opens the job page,
 * verifies (or asks for) the sign-in, fills the form and submits it. An
 * applied job leaves the list for good (the server stops serving it). */
const BOARD_COLORS = {
  linkedin: "#0a66c2", indeed: "#2557a7", naukri: "#4a90d9", foundit: "#ff6b35",
  hirist: "#22c55e", instahyre: "#e11d48",
  wellfound: "#0e3a53", cutshort: "#12b886", tophire: "#6d4aff",
  internshala: "#1a56c4", unstop: "#0894ff", glassdoor: "#0caa41",
  leetcode: "#ffa116", geeksforgeeks: "#2e8b3d", ambitionbox: "#d94f3d",
  hackerearth: "#0e3f66",
};

/* "12m ago" for a board's last fetch — the freshness a connected board is
 * supposed to promise. */
function ago(ts) {
  if (!ts) return "";
  const m = Math.round((Date.now() - ts) / 60000);
  if (m < 1) return "just now";
  if (m < 60) return `${m}m ago`;
  const h = Math.round(m / 60);
  return h < 24 ? `${h}h ago` : `${Math.round(h / 24)}d ago`;
}

/* The board whose sign-in the agent needs before it can submit, as told by
 * /api/apply/kick (needLogin). The card list says nothing about boards; this
 * is the ONE moment a board is named — because only the user can log in. */
const ASK = { board: null, name: "", open: "" };
/* Jobs the agent is working on right now (queued/opened, not yet reported).
 * A card shows "applying…" and then disappears when the submission lands. */
const PENDING = new Set();
let kickBusy = false;

function jobCard(j) {
  const [g, bg] = grade(j.match);
  const d = DATA.decisions[j.id];
  const queued = d && d.action === "apply";
  const halted = queued && d.status && d.status !== "applied";
  const busy = PENDING.has(j.id) || (queued && !halted);
  const color = BOARD_COLORS[j.board] || "#3b6fe0";
  const bits = [j.company, j.location, j.experience].filter(Boolean);
  return `
  <article class="jcard${busy ? " busy" : ""}" data-card="${j.id}">
    <div class="jcard-top">
      <div class="jcard-head">
        <div class="jcard-title">${esc(j.title)}</div>
        <div class="jcard-sub">${bits.map(esc).join(" · ")}</div>
      </div>
      <span class="jboard" style="--bc:${color}">${esc(j.boardName || j.board)}</span>
    </div>
    <p class="jcard-desc">${esc(j.desc || "—")}</p>
    <div class="jcard-foot">
      <div class="jcard-meter">
        <b class="${g}">${j.match}%</b>
        <span class="bar"><i class="${bg}" style="width:${j.match}%"></i></span>
      </div>
      ${busy
        ? `<span class="jcard-busy">applying…</span>`
        : halted
          ? `<button class="btn small" data-apply-job="${j.id}" title="${esc(d.detail || d.status)}">Apply again</button>`
          : `<button class="btn small primary" data-apply-job="${j.id}">Apply</button>`}
    </div>
  </article>`;
}

function renderCards() {
  const q = ($("#card-search")?.value || "").toLowerCase();
  const min = Number($("#card-minmatch")?.value || 0);
  const list = (DATA.jobs || [])
    .filter((j) => j.match >= min && (!q || `${j.title} ${j.company} ${j.boardName}`.toLowerCase().includes(q)))
    .sort((a, b) => b.match - a.match);
  $("#job-cards").innerHTML = list.length
    ? list.map(jobCard).join("")
    : `<div class="empty">${(DATA.jobs || []).length
        ? "No jobs match that filter — loosen the % threshold or clear the search."
        : "No jobs left to apply to. Every matched job has been applied to (applied jobs are removed from this list)."}</div>`;
  renderAsk();
  updateStats();
}

/* The only board UI there is: one line, shown when Apply needs a sign-in. */
function renderAsk() {
  const box = $("#connect-ask");
  if (!box) return;
  if (!ASK.board) {
    /* No relay on this page means no content script on any tab: Apply would
     * queue a job, open a tab and then sit at "applying…" forever, which reads
     * as "the buttons don't work". Say so instead. */
    if (!document.documentElement.hasAttribute("data-job-agent-ext")) {
      box.hidden = false;
      box.innerHTML = `<div><b>The Job Agent extension isn't loaded in this browser.</b>
        Nothing can fill or submit a job page without it — open <code>chrome://extensions</code>,
        turn on Developer mode, choose “Load unpacked” and pick <code>job-agent-ui/extension</code>,
        press its reload button, then reload this page.<br>
        <span class="ask-note">This tab is <code>${esc(location.origin)}</code>; the extension only
        marks the dashboard on <code>http://127.0.0.1:8357</code> or <code>http://localhost:8357</code>,
        and only when this extension is enabled in <em>this</em> browser profile.</span></div>`;
      return;
    }
    box.hidden = true; box.innerHTML = "";
    return;
  }
  const b = (DATA.boards || []).find((x) => x.id === ASK.board);
  const s = (b && b.session) || {};
  box.hidden = false;
  box.innerHTML = `
    <div>
      <b>${esc(ASK.name || ASK.board)}</b> isn't connected yet — sign in there once and the agent applies this job for you.
      ${s.pending ? `<span class="ask-note">checking whether you're signed in…</span>` : ""}
      ${!s.pending && s.ok === false ? `<span class="ask-note">not signed in on the site yet.</span>` : ""}
    </div>
    <button class="btn small ok" data-ask-connect="${esc(ASK.board)}" ${s.pending ? "disabled" : ""}>
      ${s.pending ? "Verifying…" : "Connect " + esc(ASK.name || ASK.board)}
    </button>`;
}

/* Open the job page without stealing the user's tab: the extension's relay on
 * this page hands the URL to the service worker (chrome.tabs.create active:false).
 * Without the extension there is nothing that could fill the form, so the tab
 * is opened visibly instead. */
function openBehind(url) {
  /* data-job-agent-ext is set by the extension's dashboard-relay.js — a DOM
   * attribute because content scripts cannot see the page's window globals. */
  if (document.documentElement.hasAttribute("data-job-agent-ext")) {
    try {
      window.postMessage({ source: "job-agent-dashboard", type: "apply:open", url }, location.origin);
      return;
    } catch { /* fall through to a normal tab */ }
  }
  window.open(url, "_blank", "noopener");
}

/* ---------- extension presence watcher ----------
 * dashboard-relay.js marks the document (data-job-agent-ext) from its own
 * isolated world. Content scripts run on Chrome's schedule, not this page's,
 * so the mark can land AFTER boot() has already painted the "isn't loaded"
 * banner — and pollFreshness only re-renders when the server data changes, so
 * on a quiet page the stale banner never cleared, no matter what. Watch the
 * attribute itself instead of sampling it once per data change. */
let EXT_PRESENT = document.documentElement.hasAttribute("data-job-agent-ext");
function syncExtPresence() {
  const now = document.documentElement.hasAttribute("data-job-agent-ext");
  if (now === EXT_PRESENT) return;
  EXT_PRESENT = now;
  renderAsk();
}
try {
  new MutationObserver(syncExtPresence).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-job-agent-ext"],
  });
} catch { /* no observer — the attribute is read live on every render anyway */ }

/* One engine turn: ask the dashboard which queued job to open next. The server
 * decides — one job at a time, never an applied one — and answers `needLogin`
 * when that board's session is not verified, so the board can be connected
 * BEFORE a tab is spent on a login wall. */
async function kickQueue() {
  if (kickBusy) return null;
  kickBusy = true;
  try {
    const res = await post("/api/apply/kick", {});
    if (res && res.needLogin) {
      ASK.board = res.needLogin;
      ASK.name = res.boardName || res.needLogin;
      ASK.open = res.open || "";
    } else if (res && res.job && res.job.url) {
      ASK.board = null;
      PENDING.add(res.job.id);
      openBehind(res.job.url);
    }
    DATA = await api("/api/bootstrap");
    renderCards();
    renderTimelineIfVisible();
    return res;
  } catch {
    return null;
  } finally {
    kickBusy = false;
  }
}

$("#card-search")?.addEventListener("input", renderCards);
$("#card-minmatch")?.addEventListener("change", renderCards);

/* Apply → the whole application happens behind the scenes. The click only
 * queues the job (decision "apply") and asks the engine for a turn; from there
 * the extension connects the board, fills and submits, and reports back — the
 * card then vanishes because the server stops serving applied jobs. */
document.addEventListener("click", async (e) => {
  const btn = e.target.closest("[data-apply-job]");
  if (!btn) return;
  const id = Number(btn.dataset.applyJob);
  const job = (DATA.jobs || []).find((x) => x.id === id);
  if (!job) return;
  PENDING.add(id);
  btn.disabled = true;
  btn.textContent = "applying…";
  await post(`/api/jobs/${id}/action`, { action: "apply" });
  const res = await kickQueue();
  /* Queued but another job is still being submitted — it will be opened as
   * soon as that page reports; nothing else to do here. */
  if (res && res.waiting) PENDING.delete(id);
  renderCards();
});

/* Connect → the board tab is opened so the extension can verify the session
 * (and, on a signed-out site, so the user can log in). Once it verifies, the
 * poll below kicks the queue again and the job the user pressed Apply on is
 * submitted without another click. */
document.addEventListener("click", async (e) => {
  const btn = e.target.closest("[data-ask-connect]");
  if (!btn) return;
  const id = btn.dataset.askConnect;
  const b = (DATA.boards || []).find((x) => x.id === id);
  const pend = !!(b && b.session && b.session.pending);
  btn.disabled = true;
  btn.textContent = "Opening…";
  await post(`/api/boards/${id}/connect`, { connected: true, ...(pend ? { force: true } : {}) });
  DATA = await api("/api/bootstrap");
  renderCards();
  if (b) window.open(b.searchUrl || b.loginUrl, "_blank", "noopener");
});

/* ---------- step 3: match % ---------- */
function jobRow(j) {
  const [g, bg] = grade(j.match);
  const d = DATA.decisions[j.id];
  return `
  <div class="job" data-job="${j.id}">
    <div class="meter">
      <div class="num ${g}">${j.match}%</div>
      <div class="bar"><i class="${bg}" style="width:${j.match}%"></i></div>
    </div>
    <div>
      <div class="job-title">${esc(j.title)}</div>
      <div class="job-meta">${esc(j.company)} · ${esc(j.location)} · ${esc(j.listed || "")}</div>
      <div class="job-chips">
        ${j.fresh ? `<span class="chip hit" title="fetched ${esc(ago(j.fetchedAt))} from the board">⚡ fresh</span>` : ""}
        ${j.matched.map((h) => `<span class="chip hit">✓ ${esc(h)}</span>`).join("")}
        ${j.missing.map((h) => `<span class="chip miss">✗ ${esc(h)}</span>`).join("")}
      </div>
      <div class="job-why">why: ${esc(j.why)}</div>
    </div>
    <div class="job-actions">
      <a class="btn small" href="${esc(j.url)}" target="_blank" rel="noopener">Open ↗</a>
      <button class="btn small ${d?.action === "approve" || d?.action === "apply" || d?.action === "applied" ? "ok" : ""}" data-quick-approve="${j.id}">
        ${d?.action === "applied" ? "✓ applied" : d?.action === "apply" ? "⏳ queued" : d?.action === "approve" ? "✓ approved" : "+ approve"}
      </button>
    </div>
  </div>`;
}

function renderJobs() {
  const q = ($("#job-search")?.value || "").toLowerCase();
  const min = Number($("#job-minmatch")?.value || 0);
  const list = DATA.jobs.filter(
    (j) => j.match >= min && (!q || `${j.title} ${j.company}`.toLowerCase().includes(q))
  );
  const top = list.slice(0, 40);
  $("#job-list").innerHTML = top.length
    ? top.map(jobRow).join("")
    : DATA.jobs.length === 0
      ? `<div class="empty">Nothing left to apply to — every matched job has been applied to (applied jobs are removed). New listings from your boards land here as you browse them.</div>`
      : `<div class="empty">No jobs match that filter. Loosen the % threshold or clear the search.</div>`;
  updateStats();
}

$("#job-search")?.addEventListener("input", renderJobs);
$("#job-minmatch")?.addEventListener("change", renderJobs);

document.addEventListener("click", async (e) => {
  const btn = e.target.closest("[data-quick-approve]");
  if (!btn) return;
  const id = btn.dataset.quickApprove;
  const cur = DATA.decisions[id];
  const action = cur?.action === "approve" ? "deny" : "approve";
  const res = await post(`/api/jobs/${id}/action`, { action });
  DATA.decisions = res.decisions;
  DATA.log = res.log;
  renderJobs();
});

/* ---------- step 4: approval queue ---------- */
function renderQueue() {
  // queue = top 15 by match, minus explicitly denied
  const rows = DATA.jobs
    .filter((j) => j.match >= 50)
    .slice(0, 15);

  $("#queue").innerHTML = rows.length
    ? rows.map((j) => {
        const d = DATA.decisions[j.id];
        const st = d?.action === "applied" ? "applied" : d?.status === "captcha" || d?.status === "failed" ? "halted" : d?.action || "";
        const label = st === "applied" ? "applied ✓" : st === "halted" ? `halted — ${d.detail || d.status}` : st === "apply" ? "queued" : st;
        const [g] = grade(j.match);
        return `
        <div class="qrow ${st}" data-job="${j.id}">
          <div class="num ${g}" style="font-size:21px;font-weight:800">${j.match}%</div>
          <div>
            <div class="job-title">${esc(j.title)}</div>
            <div class="job-meta">${esc(j.company)} · ${esc(j.location)}</div>
          </div>
          <div class="qactions">
            ${st ? `<span class="status-pill ${st}">${label}</span>` : ""}
            <button class="btn small ${st === "approved" ? "ok" : "ghost"}" data-act="approve" data-id="${j.id}">Approve</button>
            <button class="btn small ${st === "denied" ? "bad" : "ghost"}" data-act="deny" data-id="${j.id}">Skip</button>
          </div>
        </div>`;
      }).join("")
    : `<div class="empty">Nothing above 50% yet — lower the threshold on the Match step.</div>`;
  updateStats();
}

$("#queue")?.parentElement?.addEventListener("click", async (e) => {
  const btn = e.target.closest("[data-act]");
  if (!btn) return;
  const res = await post(`/api/jobs/${btn.dataset.id}/action`, { action: btn.dataset.act });
  DATA.decisions = res.decisions;
  DATA.log = res.log;
  renderQueue();
});

/* One run, one tab: the dashboard starts the queue and opens the first job.
 * From there each page reports back and the extension's worker opens the
 * next one — no tab storm, no dashboard needed to stay open. */
$("#btn-apply-approved")?.addEventListener("click", async () => {
  const approved = Object.entries(DATA.decisions)
    .filter(([, d]) => d.action === "approve" || d.action === "apply").length;
  if (!approved) {
    alert("Approve at least one job first (step 4).");
    goto("approve");
    return;
  }
  const res = await post("/api/apply/start", { cap: 25, minMatch: 0 });
  if (res.error) {
    alert(res.error);
    return;
  }
  DATA = await api("/api/bootstrap");
  renderQueue();
  goto("apply");
  if (res.first && res.first.url) window.open(res.first.url, "_blank", "noopener");
});

/* A run whose tab died mid-queue (closed browser, disabled extension, a
 * laptop that slept) leaves jobs unattempted with no page left to ask for
 * the next one. This hands out the next queued job and opens it; from there
 * the page reports back and the chain advances itself again — same
 * one-job-at-a-time handoff as always: /api/apply/next marks it attempted,
 * so the dashboard and a live page can never both get the same job. */
$("#panel-apply")?.addEventListener("click", async (e) => {
  if (!e.target.closest("#btn-resume-run")) return;
  const res = await api("/api/apply/next");
  if (res && res.job && res.job.url) window.open(res.job.url, "_blank", "noopener");
  DATA = await api("/api/bootstrap");
  renderTimelineIfVisible();
});

/* ---------- step 5: apply log / digest ---------- */
function renderTimeline() {
  const applied = DATA.jobs.filter((j) => ["apply", "applied"].includes(DATA.decisions[j.id]?.action));
  const approved = Object.values(DATA.decisions).filter((d) => d.action === "approve").length;

  const confirmed = DATA.jobs.filter((j) => DATA.decisions[j.id]?.action === "applied");
  const run = DATA.run;
  const left = run && run.total ? run.total - run.attempted : 0;
  const runLine = run && run.total
    ? `<div class="run-line">${run.done
        ? `Apply run finished — <b>${run.applied}</b> applied, <b>${run.halted}</b> halted of <b>${run.total}</b>.`
        : `Applying <b>${run.attempted}/${run.total}</b> · <b>${run.applied}</b> applied${run.halted ? ` · <b>${run.halted}</b> halted` : ""} — keep the browser open.`
          + (left > 0 ? ` <button class="btn small" id="btn-resume-run" title="Opens the next queued job; from there the page reports back and the chain advances itself">Resume — open queued job ${run.attempted + 1} of ${run.total}</button>` : "")}</div>`
    : "";
  $("#digest-body").innerHTML = runLine + (applied.length || confirmed.length
    ? `Good morning 👋 <b>${confirmed.length}</b> application${confirmed.length === 1 ? "" : "s"} submitted by the agent${confirmed.length ? " (confirmations below)" : ""}, <b>${applied.length - confirmed.length}</b> queued.<br>
       ${confirmed.slice(0, 5).map((j) => `• ✓ ${esc(j.title)} @ ${esc(j.company)} (${j.match}%)${DATA.decisions[j.id]?.confirmation ? ` — ${esc(DATA.decisions[j.id].confirmation)}` : ""}`).join("<br>")}
       ${confirmed.length > 5 ? `<br>…and ${confirmed.length - 5} more` : ""}`
    : `No applications yet. Approve jobs in step 4, then hit <b>Apply to approved jobs</b> — the agent opens each approved job in turn, fills and submits it, and reports the confirmation back here.`);

  $("#timeline").innerHTML = DATA.log.length
    ? DATA.log.slice(0, 30).map((l) => `
        <div class="tl-item ${l.type}">
          <span class="ts">${new Date(l.ts).toLocaleTimeString()}</span>${esc(l.text)}
        </div>`).join("")
    : `<div class="empty">Activity will appear here as you connect boards and apply.</div>`;
  updateStats();
}

function renderTimelineIfVisible() {
  if ($("#panel-apply").classList.contains("active")) renderTimeline();
}

$("#btn-restart")?.addEventListener("click", async () => {
  if (!confirm("Reset connections, approvals and the apply log?")) return;
  await fetch("/api/reset", { method: "POST" });
  DATA = await api("/api/bootstrap");
  renderProfile(); renderCards(); renderJobs(); renderTimeline();
  goto("profile");
});

/* ---------- stats ---------- */
function updateStats() {
  $("#stat-connected").textContent = DATA.boards.filter((b) => b.connected).length;
  $("#stat-approved").textContent = Object.values(DATA.decisions).filter(
    (d) => d.action === "approve" || d.action === "apply"
  ).length;
  $("#stat-applied").textContent = Object.values(DATA.decisions).filter(
    (d) => d.action === "applied" || d.action === "apply"
  ).length;
}

/* ---------- freshness poll ---------- */
/* Fresh listings POST themselves from the extension's board tabs — poll so
 * the lists update without a manual reload. Never re-renders the profile
 * form (typing there must not be clobbered). */
function dataSig(d) {
  return JSON.stringify([
    d.jobs.map((j) => j.id),
    /* session must ride along: a verdict flipping pending -> "not signed
     * in" changes nothing else, and the card hint would never re-render */
    d.boards.map((b) => [b.id, b.connected, b.jobs, b.fetchedAt,
      b.session && [b.session.ok, b.session.pending, b.session.at, b.session.detail]]),
    d.decisions,
    d.run,
    d.boards.map((b) => b.sweep && [b.sweep.status, b.sweep.page, b.sweep.found]),
  ]);
}
let POLL_SIG = "";
async function pollFreshness() {
  if (document.visibilityState !== "visible") return;
  try {
    const next = await api("/api/bootstrap");
    const sig = dataSig(next);
    if (sig === POLL_SIG) return;
    POLL_SIG = sig;
    DATA = next;
    renderCards();
    renderJobs();
    if ($("#panel-approve").classList.contains("active")) renderQueue();
    renderTimelineIfVisible();
    /* A card the agent finished no longer exists in `jobs` — drop its busy
     * marker so a retry card would render fresh if one reappears. */
    for (const id of [...PENDING]) {
      if (!DATA.jobs.some((j) => j.id === id)) PENDING.delete(id);
    }
    /* The user connected the board the agent was waiting on: hand the queued
     * job straight out — no second Apply click. */
    if (ASK.board) {
      const b = (DATA.boards || []).find((x) => x.id === ASK.board);
      if (b && b.connected) {
        ASK.board = null;
        await kickQueue();
      }
    }
  } catch { /* dashboard restarting — next tick retries */ }
}
setInterval(pollFreshness, 10000);

/* ---------- queue watchdog — keep the queues moving by themselves ----------
 * The chain only advances while a job page is alive: each page reports back
 * and the server hands out the next job. When the last tab dies mid-run
 * (closed browser, crashed tab, a job page that never loaded) nothing asks
 * again — the run sits with jobs left and the manual Resume button was the
 * only cure. This watches both queues instead:
 *
 *  - a run that still has jobs left and has seen NO activity for
 *    QUEUE_STALL_MS is resumed automatically — the dashboard takes the next
 *    queued job itself (/api/apply/next marks it attempted, so a live page
 *    can never be handed the same one) and opens it, exactly like pressing
 *    Resume. "Activity" is any decision timestamp: the report a live chain
 *    posts rewrites that job's decision, and a queue click touches one too.
 *
 *  - a fetch-all whose board tab died is marked `stalled` by the server
 *    (its own liveness check); the dashboard restarts it and opens the board
 *    so the extension picks the page-walk back up. Capped per session so a
 *    board that can't be logged into can never spam tabs.
 *
 * At most one action per quiet period (shared lastAutoKick), and a kick
 * never overlaps itself, so a slow-filling job can't trigger a tab storm:
 * worst case one extra open per QUEUE_STALL_MS while a fill runs long. */
const QUEUE_STALL_MS = 150000;
let lastAutoKick = 0;
let kickInFlight = false;
let sweepAutoRestarts = 0;

async function queueWatchdog() {
  if (!DATA || kickInFlight || document.visibilityState !== "visible") return;
  const now = Date.now();
  if (now - lastAutoKick <= QUEUE_STALL_MS) return;

  /* --- a run with jobs left and no live page: resume it --- */
  const run = DATA.run;
  if (run && !run.done && run.attempted < run.total) {
    let lastActivity = run.startedAt || 0;
    for (const d of Object.values(DATA.decisions || {})) {
      if (d && typeof d.ts === "number" && d.ts > lastActivity) lastActivity = d.ts;
    }
    if (now - lastActivity > QUEUE_STALL_MS) {
      kickInFlight = true;
      try {
        const res = await api("/api/apply/next");
        if (res && res.job && res.job.url) {
          lastAutoKick = now;                 // armed only when a job really opened
          window.open(res.job.url, "_blank", "noopener");
          DATA = await api("/api/bootstrap");
          renderTimelineIfVisible();
        }
      } catch { /* dashboard restarting — next tick retries */ }
      finally { kickInFlight = false; }
      return;                                  // one action per tick
    }
  }

  /* --- a stalled fetch-all: restart it and open the board tab --- */
  const dead = (DATA.boards || []).find((b) => b.sweep && b.sweep.status === "stalled");
  if (dead && sweepAutoRestarts < 3) {
    kickInFlight = true;
    try {
      await post(`/api/boards/${dead.id}/sweep`, { pages: dead.sweep.maxPages || 5 });
      sweepAutoRestarts += 1;
      lastAutoKick = now;
      window.open(dead.searchUrl || dead.loginUrl, "_blank", "noopener");
      DATA = await api("/api/bootstrap");
      renderCards();
      renderTimelineIfVisible();
    } catch { /* dashboard restarting — next tick retries */ }
    finally { kickInFlight = false; }
  }
}
setInterval(queueWatchdog, 10000);

/* ---------- boot ---------- */
(async function boot() {
  DATA = await api("/api/bootstrap");
  POLL_SIG = dataSig(DATA);
  renderProfile();
  renderCards();
  renderJobs();
  renderTimeline();
})();

/* My Job Agent — client. Talks to server.js API; all data is real pipeline output. */
"use strict";

let DATA = null; // { profile, boards, jobs, decisions, log }

/* ---------- helpers ---------- */
const $ = (s, el = document) => el.querySelector(s);
const $$ = (s, el = document) => [...el.querySelectorAll(s)];
const esc = (s) => String(s ?? "").replace(/[&<>\"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

function grade(m) {
  if (m >= 75) return ["g-hi", "bg-hi"];
  if (m >= 50) return ["g-mid", "bg-mid"];
  return ["g-lo", "bg-lo"];
}

async function api(path, opts) {
  const r = await fetch(path, opts);
  if (!r.ok) throw new Error(`${path} -> ${r.status}`);
  return r.json();
}

function post(path, body) {
  return api(path, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body || {}),
  });
}

/* ---------- step navigation ---------- */
const ORDER = ["profile", "boards", "match", "approve", "apply"];

function goto(step) {
  $$(".step").forEach((b) => {
    const s = b.dataset.step;
    b.classList.toggle("active", s === step);
    b.classList.toggle("done", ORDER.indexOf(s) < ORDER.indexOf(step));
  });
  $$(".panel").forEach((p) => p.classList.toggle("active", p.id === `panel-${step}`));
  $(".main").scrollTop = 0;
  if (step === "approve") renderQueue();
  if (step === "apply") renderTimeline();
}

document.addEventListener("click", (e) => {
  const stepBtn = e.target.closest(".step");
  if (stepBtn) return goto(stepBtn.dataset.step);
  const gotoBtn = e.target.closest("[data-goto]");
  if (gotoBtn) return goto(gotoBtn.dataset.goto);
});

/* ---------- step 1: profile ---------- */
function renderProfile() {
  const p = DATA.profile;
  $("#f-name").value = p.name;
  $("#f-email").value = p.email;
  $("#f-phone").value = p.phone;
  $("#f-location").value = p.location;
  $("#role-chips").innerHTML = p.targetRoles.map((r) => `<span class="chip">${esc(r)}</span>`).join("");

  // Fill pack: count ready values, list the questions the agent must ask.
  const f = DATA.fill;
  if (f) {
    const flat = [];
    (function walk(o, depth) {
      if (depth > 4 || o == null) return;
      if (Array.isArray(o)) return o.forEach((v) => walk(v, depth + 1));
      if (typeof o !== "object") return;
      for (const [k, v] of Object.entries(o)) {
        if (k.startsWith("_") || k === "askUser" || k === "questions") continue;
        if (v === null) continue;
        if (typeof v === "object") walk(v, depth + 1);
        else flat.push(k);
      }
    })(f, 0);
    const need = (f.askUser || []).length;
    $("#fill-ready").textContent = `${flat.length} fields ready`;
    $("#fill-need").textContent = `${need} open`;
    $("#fill-ask").innerHTML = (f.askUser || [])
      .map((a) => `<li><b>${esc(a.field)}</b> — ${esc(a.why)}</li>`)
      .join("");
  }
}

/* ---------- step 2: boards ---------- */
const BOARD_COLORS = {
  linkedin: "#0a66c2", indeed: "#2557a7", naukri: "#4a90d9", foundit: "#ff6b35",
  hirist: "#22c55e", instahyre: "#e11d48",
  wellfound: "#0e3a53", cutshort: "#12b886", tophire: "#6d4aff",
  internshala: "#1a56c4", unstop: "#0894ff", glassdoor: "#0caa41",
  leetcode: "#ffa116", geeksforgeeks: "#2e8b3d", ambitionbox: "#d94f3d",
  hackerearth: "#0e3f66",
};

/* "12m ago" for a board's last fetch — the freshness a connected board is
 * supposed to promise. */
function ago(ts) {
  if (!ts) return "";
  const m = Math.round((Date.now() - ts) / 60000);
  if (m < 1) return "just now";
  if (m < 60) return `${m}m ago`;
  const h = Math.round(m / 60);
  return h < 24 ? `${h}h ago` : `${Math.round(h / 24)}d ago`;
}

function renderBoards() {
  $("#board-grid").innerHTML = DATA.boards.map((b) => {
    const s = b.session || {};
    const pend = !!s.pending;
    const lost = !b.connected && s.ok === false && !s.unknown && !pend;
    const status = b.connected ? "connected" : pend ? "verifying session…" : "not connected";
    return `
    <div class="board ${b.connected ? "connected" : ""}" data-board="${b.id}">
      <div class="board-top">
        <div class="board-logo" style="background:${BOARD_COLORS[b.id] || "#555"}">${esc(b.name.slice(0, 2))}</div>
        <div>
          <div class="board-name">${esc(b.name)}</div>
          <span class="badge ${b.kind === "session-gated" ? "session" : "auto"}">
            ${b.kind === "session-gated" ? "session-gated" : "cookie-session"}
          </span>
        </div>
      </div>
      <p>${esc(b.note)}</p>
      ${pend ? `<div class="hint"><b>${esc(b.name)}:</b> checking whether you're actually signed in — the board tab it opened tells us. Log in there if you haven't. ${s.pendingMs > 20000 ? `Still waiting after ${Math.round(s.pendingMs / 1000)}s — reload the extension at chrome://extensions (v2.12.0), or use "Connect without verifying".` : ""}</div>` : ""}
      ${lost ? `<div class="hint"><b>${esc(b.name)}:</b> you're not signed in on the site — log in in the opened tab, then connect again.</div>` : ""}
      ${b.sweep && b.sweep.status === "running" ? `<div class="hint"><b>${esc(b.name)}:</b> fetching all listings — page ${b.sweep.page || 0}/${b.sweep.maxPages || 1}, ${b.sweep.found || 0} new so far. Keep the board tab open.</div>` : ""}
      ${b.sweep && b.sweep.status === "stalled" ? `<div class="hint"><b>${esc(b.name)}:</b> fetch-all stalled — the board tab closed or the extension reloaded, so no page progress arrived. Press <b>Fetch all jobs</b> to restart it.</div>` : ""}
      ${b.sweep && b.sweep.status === "done" ? `<div class="hint"><b>${esc(b.name)}:</b> fetch-all finished — ${b.sweep.found || 0} new job${(b.sweep.found || 0) === 1 ? "" : "s"} from ${b.sweep.page || 1} page${(b.sweep.page || 1) === 1 ? "" : "s"}.</div>` : ""}
      <div class="board-actions">
        <span class="conn-dot"></span>
        <span class="conn-label">${status}${b.connected && b.fetchedAt ? ` · fetched ${ago(b.fetchedAt)}` : ""}</span>
        <span style="flex:1"></span>
        ${b.connected
          ? `<button class="btn small ok" data-fetch="${b.id}" ${b.sweep && b.sweep.status === "running" ? "disabled" : ""}>
               ${b.sweep && b.sweep.status === "running" ? `Fetching… ${b.sweep.page || 0}/${b.sweep.maxPages || 1}` : "Fetch all jobs ⇣"}
             </button>`
          : `<a class="btn small" href="${esc(b.loginUrl)}" target="_blank" rel="noopener">Open login ↗</a>`}
        <button class="btn small ${b.connected ? "bad" : "ok"}" data-connect="${b.id}">
          ${b.connected ? "Disconnect" : pend ? "Connect without verifying" : "I'm signed in — connect"}
        </button>
      </div>
    </div>`;
  }).join("");
  updateStats();
}

document.addEventListener("click", async (e) => {
  const btn = e.target.closest("[data-connect]");
  if (!btn) return;
  const id = btn.dataset.connect;
  const b = DATA.boards.find((x) => x.id === id);
  const pend = !!(b.session && b.session.pending);
  /* Connect is a CLAIM until the extension verifies it on the board tab —
   * the server holds it in `pending`. A second click while pending is the
   * user's explicit "skip verification" (still opens the tab: jobs are
   * fetched from there either way). Disconnect is immediate. */
  const body = b.connected
    ? { connected: false }
    : { connected: true, ...(pend ? { force: true } : {}) };
  const res = await post(`/api/boards/${id}/connect`, body);
  DATA.boards = res.boards || DATA.boards;
  DATA.log = res.log;
  // re-fetch to keep state canonical
  DATA = await api("/api/bootstrap");
  renderBoards();
  renderJobs();
  renderTimelineIfVisible();
  /* The board tab is where login is verified AND jobs are fetched. */
  if (!b.connected && b.searchUrl) window.open(b.searchUrl, "_blank", "noopener");
});

/* "Fetch all jobs" starts a page-walking sweep on the dashboard and opens the
 * board so the extension can run it: every result page is harvested until the
 * cap. The server dedupes, so re-fetching never duplicates a job. */
document.addEventListener("click", async (e) => {
  const btn = e.target.closest("[data-fetch]");
  if (!btn) return;
  const b = DATA.boards.find((x) => x.id === btn.dataset.fetch);
  if (!b) return;
  await post(`/api/boards/${b.id}/sweep`, { pages: 5 });
  window.open(b.searchUrl || b.loginUrl, "_blank", "noopener");
  DATA = await api("/api/bootstrap");
  renderBoards();
});

/* ---------- step 3: match % ---------- */
function jobRow(j) {
  const [g, bg] = grade(j.match);
  const d = DATA.decisions[j.id];
  return `
  <div class="job" data-job="${j.id}">
    <div class="meter">
      <div class="num ${g}">${j.match}%</div>
      <div class="bar"><i class="${bg}" style="width:${j.match}%"></i></div>
    </div>
    <div>
      <div class="job-title">${esc(j.title)}</div>
      <div class="job-meta">${esc(j.company)} · ${esc(j.location)} · ${esc(j.listed || "")}</div>
      <div class="job-chips">
        ${j.fresh ? `<span class="chip hit" title="fetched ${esc(ago(j.fetchedAt))} from the board">⚡ fresh</span>` : ""}
        ${j.matched.map((h) => `<span class="chip hit">✓ ${esc(h)}</span>`).join("")}
        ${j.missing.map((h) => `<span class="chip miss">✗ ${esc(h)}</span>`).join("")}
      </div>
      <div class="job-why">why: ${esc(j.why)}</div>
    </div>
    <div class="job-actions">
      <a class="btn small" href="${esc(j.url)}" target="_blank" rel="noopener">Open ↗</a>
      <button class="btn small ${d?.action === "approve" || d?.action === "apply" || d?.action === "applied" ? "ok" : ""}" data-quick-approve="${j.id}">
        ${d?.action === "applied" ? "✓ applied" : d?.action === "apply" ? "⏳ queued" : d?.action === "approve" ? "✓ approved" : "+ approve"}
      </button>
    </div>
  </div>`;
}

function renderJobs() {
  const q = ($("#job-search")?.value || "").toLowerCase();
  const min = Number($("#job-minmatch")?.value || 0);
  const list = DATA.jobs.filter(
    (j) => j.match >= min && (!q || `${j.title} ${j.company}`.toLowerCase().includes(q))
  );
  const top = list.slice(0, 40);
  $("#job-list").innerHTML = top.length
    ? top.map(jobRow).join("")
    : DATA.jobs.length === 0
      ? DATA.boards.some((b) => b.connected)
        ? `<div class="empty">Connected, but no jobs fetched yet — hit <b>Fetch fresh jobs ↗</b> in step 2 (opens the board in your logged-in tab; the extension reads its listings and they appear here automatically).</div>`
        : `<div class="empty">No boards connected yet — connect a board in step 2 and its matched jobs show up here.</div>`
      : `<div class="empty">No jobs match that filter. Loosen the % threshold or clear the search.</div>`;
  updateStats();
}

$("#job-search")?.addEventListener("input", renderJobs);
$("#job-minmatch")?.addEventListener("change", renderJobs);

document.addEventListener("click", async (e) => {
  const btn = e.target.closest("[data-quick-approve]");
  if (!btn) return;
  const id = btn.dataset.quickApprove;
  const cur = DATA.decisions[id];
  const action = cur?.action === "approve" ? "deny" : "approve";
  const res = await post(`/api/jobs/${id}/action`, { action });
  DATA.decisions = res.decisions;
  DATA.log = res.log;
  renderJobs();
});

/* ---------- step 4: approval queue ---------- */
function renderQueue() {
  // queue = top 15 by match, minus explicitly denied
  const rows = DATA.jobs
    .filter((j) => j.match >= 50)
    .slice(0, 15);

  $("#queue").innerHTML = rows.length
    ? rows.map((j) => {
        const d = DATA.decisions[j.id];
        const st = d?.action === "applied" ? "applied" : d?.status === "captcha" || d?.status === "failed" ? "halted" : d?.action || "";
        const label = st === "applied" ? "applied ✓" : st === "halted" ? `halted — ${d.detail || d.status}` : st === "apply" ? "queued" : st;
        const [g] = grade(j.match);
        return `
        <div class="qrow ${st}" data-job="${j.id}">
          <div class="num ${g}" style="font-size:21px;font-weight:800">${j.match}%</div>
          <div>
            <div class="job-title">${esc(j.title)}</div>
            <div class="job-meta">${esc(j.company)} · ${esc(j.location)}</div>
          </div>
          <div class="qactions">
            ${st ? `<span class="status-pill ${st}">${label}</span>` : ""}
            <button class="btn small ${st === "approved" ? "ok" : "ghost"}" data-act="approve" data-id="${j.id}">Approve</button>
            <button class="btn small ${st === "denied" ? "bad" : "ghost"}" data-act="deny" data-id="${j.id}">Skip</button>
          </div>
        </div>`;
      }).join("")
    : `<div class="empty">Nothing above 50% yet — lower the threshold on the Match step.</div>`;
  updateStats();
}

$("#queue")?.parentElement?.addEventListener("click", async (e) => {
  const btn = e.target.closest("[data-act]");
  if (!btn) return;
  const res = await post(`/api/jobs/${btn.dataset.id}/action`, { action: btn.dataset.act });
  DATA.decisions = res.decisions;
  DATA.log = res.log;
  renderQueue();
});

/* One run, one tab: the dashboard starts the queue and opens the first job.
 * From there each page reports back and the extension's worker opens the
 * next one — no tab storm, no dashboard needed to stay open. */
$("#btn-apply-approved")?.addEventListener("click", async () => {
  const approved = Object.entries(DATA.decisions)
    .filter(([, d]) => d.action === "approve" || d.action === "apply").length;
  if (!approved) {
    alert("Approve at least one job first (step 4).");
    goto("approve");
    return;
  }
  const res = await post("/api/apply/start", { cap: 25, minMatch: 0 });
  if (res.error) {
    alert(res.error);
    return;
  }
  DATA = await api("/api/bootstrap");
  renderQueue();
  goto("apply");
  if (res.first && res.first.url) window.open(res.first.url, "_blank", "noopener");
});

/* A run whose tab died mid-queue (closed browser, disabled extension, a
 * laptop that slept) leaves jobs unattempted with no page left to ask for
 * the next one. This hands out the next queued job and opens it; from there
 * the page reports back and the chain advances itself again — same
 * one-job-at-a-time handoff as always: /api/apply/next marks it attempted,
 * so the dashboard and a live page can never both get the same job. */
$("#panel-apply")?.addEventListener("click", async (e) => {
  if (!e.target.closest("#btn-resume-run")) return;
  const res = await api("/api/apply/next");
  if (res && res.job && res.job.url) window.open(res.job.url, "_blank", "noopener");
  DATA = await api("/api/bootstrap");
  renderTimelineIfVisible();
});

/* ---------- step 5: apply log / digest ---------- */
function renderTimeline() {
  const applied = DATA.jobs.filter((j) => ["apply", "applied"].includes(DATA.decisions[j.id]?.action));
  const approved = Object.values(DATA.decisions).filter((d) => d.action === "approve").length;

  const confirmed = DATA.jobs.filter((j) => DATA.decisions[j.id]?.action === "applied");
  const run = DATA.run;
  const left = run && run.total ? run.total - run.attempted : 0;
  const runLine = run && run.total
    ? `<div class="run-line">${run.done
        ? `Apply run finished — <b>${run.applied}</b> applied, <b>${run.halted}</b> halted of <b>${run.total}</b>.`
        : `Applying <b>${run.attempted}/${run.total}</b> · <b>${run.applied}</b> applied${run.halted ? ` · <b>${run.halted}</b> halted` : ""} — keep the browser open.`
          + (left > 0 ? ` <button class="btn small" id="btn-resume-run" title="Opens the next queued job; from there the page reports back and the chain advances itself">Resume — open queued job ${run.attempted + 1} of ${run.total}</button>` : "")}</div>`
    : "";
  $("#digest-body").innerHTML = runLine + (applied.length || confirmed.length
    ? `Good morning 👋 <b>${confirmed.length}</b> application${confirmed.length === 1 ? "" : "s"} submitted by the agent${confirmed.length ? " (confirmations below)" : ""}, <b>${applied.length - confirmed.length}</b> queued.<br>
       ${confirmed.slice(0, 5).map((j) => `• ✓ ${esc(j.title)} @ ${esc(j.company)} (${j.match}%)${DATA.decisions[j.id]?.confirmation ? ` — ${esc(DATA.decisions[j.id].confirmation)}` : ""}`).join("<br>")}
       ${confirmed.length > 5 ? `<br>…and ${confirmed.length - 5} more` : ""}`
    : `No applications yet. Approve jobs in step 4, then hit <b>Apply to approved jobs</b> — the agent opens each approved job in turn, fills and submits it, and reports the confirmation back here.`);

  $("#timeline").innerHTML = DATA.log.length
    ? DATA.log.slice(0, 30).map((l) => `
        <div class="tl-item ${l.type}">
          <span class="ts">${new Date(l.ts).toLocaleTimeString()}</span>${esc(l.text)}
        </div>`).join("")
    : `<div class="empty">Activity will appear here as you connect boards and apply.</div>`;
  updateStats();
}

function renderTimelineIfVisible() {
  if ($("#panel-apply").classList.contains("active")) renderTimeline();
}

$("#btn-restart")?.addEventListener("click", async () => {
  if (!confirm("Reset connections, approvals and the apply log?")) return;
  await fetch("/api/reset", { method: "POST" });
  DATA = await api("/api/bootstrap");
  renderProfile(); renderBoards(); renderJobs(); renderTimeline();
  goto("profile");
});

/* ---------- stats ---------- */
function updateStats() {
  $("#stat-connected").textContent = DATA.boards.filter((b) => b.connected).length;
  $("#stat-approved").textContent = Object.values(DATA.decisions).filter(
    (d) => d.action === "approve" || d.action === "apply"
  ).length;
  $("#stat-applied").textContent = Object.values(DATA.decisions).filter(
    (d) => d.action === "applied" || d.action === "apply"
  ).length;
}

/* ---------- freshness poll ---------- */
/* Fresh listings POST themselves from the extension's board tabs — poll so
 * the lists update without a manual reload. Never re-renders the profile
 * form (typing there must not be clobbered). */
function dataSig(d) {
  return JSON.stringify([
    d.jobs.map((j) => j.id),
    /* session must ride along: a verdict flipping pending -> "not signed
     * in" changes nothing else, and the card hint would never re-render */
    d.boards.map((b) => [b.id, b.connected, b.jobs, b.fetchedAt,
      b.session && [b.session.ok, b.session.pending, b.session.at, b.session.detail]]),
    d.decisions,
    d.run,
    d.boards.map((b) => b.sweep && [b.sweep.status, b.sweep.page, b.sweep.found]),
  ]);
}
let POLL_SIG = "";
async function pollFreshness() {
  if (document.visibilityState !== "visible") return;
  try {
    const next = await api("/api/bootstrap");
    const sig = dataSig(next);
    if (sig === POLL_SIG) return;
    POLL_SIG = sig;
    DATA = next;
    renderBoards();
    renderJobs();
    if ($("#panel-approve").classList.contains("active")) renderQueue();
    renderTimelineIfVisible();
  } catch { /* dashboard restarting — next tick retries */ }
}
setInterval(pollFreshness, 10000);

/* ---------- boot ---------- */
(async function boot() {
  DATA = await api("/api/bootstrap");
  POLL_SIG = dataSig(DATA);
  renderProfile();
  renderBoards();
  renderJobs();
  renderTimeline();
})();
